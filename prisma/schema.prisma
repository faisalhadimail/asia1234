generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  email     String?  @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("AdminUser")
}

model PropertyType {
  id           String   @id @default(cuid())
  name         String   @unique
  icon         String   @default("home")
  displayOrder Int      @default(0) @map("displayOrder")

  @@map("PropertyType")
}

model Location {
  id        String   @id @default(cuid())
  kabupaten String   @unique
  kecamatan String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Location")
}

model Agent {
  id           String   @id @default(cuid())
  name         String
  role         String?
  phone        String?
  email        String?
  image        String?
  whatsapp     String?
  displayOrder Int      @default(0) @map("displayOrder")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("Agent")
}

model Promo {
  id           String   @id @default(cuid())
  badge        String?
  title        String?
  subtitle      String?
  description   String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0) @map("displayOrder")

  properties PropertyPromo[]

  @@map("Promo")
}

model Property {
  id           String   @id @default(cuid())
  type         String
  title        String
  description  String?
  buildingType String?
  price        Float
  dp           Float    @default(0)
  allInCost    Float    @default(0)
  kabupaten    String
  kecamatan    String?
  location     String?
  images       String   @default("[]")
  bedrooms     Int?
  bathrooms    Int?
  carports     Int?
  buildingSize Int?
  landSize     Int?
  electricity  Int?
  water        String?
  certificate  String?
  facilities   String   @default("[]")
  contact      String?
  status       String   @default("available")
  featured     Boolean  @default(false)
  permalink    String   @unique
  brochure     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  promos PropertyPromo[]

  @@map("Property")
}

model PropertyPromo {
  propertyId String
  promoId    String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  promo    Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@id([propertyId, promoId])
  @@map("PropertyPromo")
}

model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String?
  image     String?
  category  String   @default("General")
  author    String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Article")
}

model Review {
  id          String   @id @default(cuid())
  name        String
  review      String
  rating      Int      @default(5)
  image       String?
  featured    Boolean  @default(false)
  propertyId  String?
  propertyTitle String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Review")
}

model Visitor {
  id        String   @id @default(uuid())
  date      String   @default("")
  name      String?
  phone     String?
  email     String?
  type      String?
  building  String?
  location  String?
  dp        String?
  promo     String?
  status    String   @default("new")
  notes     String?
  interest  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Visitor")
}
